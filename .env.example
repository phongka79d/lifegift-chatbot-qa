# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Live MySQL Database (Docker container on port 3307)
DATABASE_URL=mysql+pymysql://root:rootpassword@127.0.0.1:3307/lifegift_db?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=lifegift_db

# Live Qdrant Vector Database (Docker container on port 6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lifegift_knowledge

# LLM Configuration
LLM_MODEL=gpt-4.1-nano
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.shopaikey.com/v1

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_embedding_api_key_here
